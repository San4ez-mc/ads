{
  "name": "fineko-ads",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=18" },
  "scripts": {
    "dev:api": "npm run dev -w @ads/api",
    "dev:admin": "npm run dev -w @ads/admin",
    "build:admin": "npm run build -w @ads/admin",
    "db:generate": "npm run generate -w @ads/db",
    "db:push": "npm run push -w @ads/db",
    "test": "node --test apps/api/test/sync.test.js apps/api/test/bundles-flows.test.js"
  }
}
