# FINEKO Ads — приклад .env (реальний .env у git не комітимо)
PORT=4900
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fineko_ads
# SSO (OAuth-клієнт "ads" реєструється в SSO через POST /admin/clients)
SSO_URL=http://localhost:4600
SSO_CLIENT_ID=ads
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:4900/auth/callback
# Куди повертати після входу. Dev: Vite на 5175; прод: https://ads.fineko.space
ADMIN_BASE_URL=http://localhost:5175
ALLOWED_ORIGINS=http://localhost:5175
# Ключ шифрування ключів кабінетів: 64 hex-символи (openssl rand -hex 32). Загубити = заново вводити всі ключі кабінетів.
ADS_SECRET_KEY=
# Версія Marketing API Meta
META_API_VERSION=v26.0
